# Base de datos PostgreSQL (ej. Supabase, Neon, Railway o instancia propia)
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_bd?sslmode=require"

# URL base de la aplicación (en Vercel usar https://tu-dominio.vercel.app o NEXT_PUBLIC_VERCEL_URL)
APP_URL="https://tu-dominio.vercel.app"

# Secreto para sesiones y encriptación de tokens (generar string seguro aleatorio)
SESSION_SECRET="generar-un-secreto-aleatorio-seguro-de-al-menos-32-caracteres"

# Integraciones: solo en el servidor. Sin ellas: «Modo demo» (INTEGRATIONS_DEMO=1, por defecto fuera de producción) o «Sin configurar».
INTEGRATIONS_DEMO="1"
CRON_SECRET=""
INGEST_RATE_PER_MIN="60"
